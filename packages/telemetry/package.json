    },
    "./browser/client": {
      "types": "./dist/browser/client.d.ts",
      "import": "./dist/browser/client.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-packages.ts",
    "prepack": "bun run build"
