{
  "name": "observability",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "check": "vp check",
    "compat": "bun scripts/compatibility-gate.ts",
    "build": "bun scripts/build-packages.ts",
    "test": "vp test run && bun run test:bun",
    "test:bun": "bun test $(find packages tools -name '*.bun.test.ts' -print) --timeout 30000",
    "test:browser": "(test -f packages/react/dist/index.js || (echo 'test:browser requires an existing dist; run bun run build first.' >&2; exit 1)) && vp test run --config packages/react/vite.browser.config.ts",
    "test:canary": "vp test run packages/telemetry/test/canary.test.ts packages/telemetry/test/collectorRedaction.test.ts",
    "test:canary:deployed": "vp test run packages/telemetry/test/canary.deployed.test.ts",
    "test:package": "bun scripts/package-smoke.ts",
    "lint": "vp lint .",
    "fix": "vp check --fix",
    "format": "vp fmt --write .",
    "commitlint": "commitlint",
    "repos:sync": "bun scripts/agent-repos.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@effect/vitest": "4.0.0-rc.111",
    "@oxlint/plugins": "1.79.0",
    "@types/bun": "1.4.0",
    "@vitest/browser-playwright": "4.1.11",
    "effect": "4.0.0-rc.111",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "playwright": "^1.62.1",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11",
    "yuku-parser": "0.5.48"
  },
  "packageManager": "bun@1.4.0"
}
